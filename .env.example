# Copy this file to ".env" (same folder as check.py) and fill in your values.
# Leave a channel's lines empty to disable it. Never commit .env.
# Set to "windowed" or "headless" to force a browser mode; blank tries both.
BROWSER_MODE=
# Email (Gmail App Password, no spaces)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=abcdefghijklmnop
EMAIL_TO=you@gmail.com
# WhatsApp via CallMeBot (optional)
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=